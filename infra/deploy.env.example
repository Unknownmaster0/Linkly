# deploy.env — lives at $HOME/deploy.env on the EC2 instance (never committed).
# Copy this file there and fill in every value before running deploy.sh.
#
# Usage:
#   scp infra/deploy.env.example ec2-user@<host>:~/deploy.env
#   ssh ec2-user@<host> "nano ~/deploy.env"

# ── Required ────────────────────────────────────────────────────────────────
# deploy.sh exits immediately if any of these are empty.

REPO_URL=git@github.com:user/repo.git
APP_DIR=/home/ec2-user/url-shortener
DEPLOY_BRANCH=main

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=urlshortener

VALKEY_PASSWORD=

JWT_SECRET=
JWT_REFRESH_SECRET=
IP_HASH_SECRET=

# Public-facing URLs (no trailing slash)
BASE_URL=https://api.example.com
REDIRECT_URL=https://go.example.com
# Comma-separated list of allowed browser origins
CLIENT_ORIGINS=https://app.example.com

# ── Optional ─────────────────────────────────────────────────────────────────
# deploy.sh uses these defaults when the variable is absent or empty.

DEFAULT_URL_TTL_DAYS=7

RATE_LIMIT_CREATE_LIMIT=100
RATE_LIMIT_WINDOW_SECS=3600
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW_SECS=60
RATE_LIMIT_LOGIN_ACCOUNT_LIMIT=10
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECS=900
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_REGISTER_WINDOW_SECS=60
RATE_LIMIT_REDIRECT_LIMIT=100
RATE_LIMIT_REDIRECT_WINDOW_SECS=60

GEO_ENABLED=true
GEO_TIMEOUT_MS=2000
CLICK_BATCH_SIZE=100
CLICK_FLUSH_MS=5000
WORKER_CONCURRENCY=10
SHUTDOWN_TIMEOUT_MS=30000

HEALTH_CHECK_RETRIES=5
HEALTH_CHECK_INTERVAL_SECS=3

# Memory threshold (percent of total RAM) at which deploy.sh will reload PM2
# processes before continuing. 85 is a safe default for t3.small (2 GB) and up.
MEMORY_RELOAD_THRESHOLD_PERCENT=85

# Documented only — client builds on Vercel, not on EC2.
# Set this in the Vercel project environment variables.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com