{
  "name": "worker",
  "version": "1.0.0",
  "description": "BullMQ worker — async analytics pipeline + daily aggregation",
  "main": "dist/worker.js",
  "scripts": {
    "dev": "tsx src/worker.ts",
    "build": "tsc && node scripts/fix-prisma-imports.mjs",
    "start": "node dist/worker.js",
    "type-check": "npx tsc --noEmit",
    "generate": "prisma generate",
    "test": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "job:aggregate": "tsx src/jobs/run-aggregation.ts",
    "job:expire": "tsx src/jobs/run-expiry.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@url-shortener/shared": "*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "bullmq": "^5.34.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "node-cron": "^3.0.3",
    "pg": "^8.20.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.3",
    "ua-parser-js": "^1.0.39"
  },
  "devDependencies": {
    "@types/node": "^20.19.42",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/ua-parser-js": "^0.7.39",
    "@vitest/coverage-v8": "^2.1.8",
    "cron-parser": "^4.9.0",
    "prisma": "^7.7.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.8"
  }
}
