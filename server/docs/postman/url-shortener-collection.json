        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 400) {",
          "    pm.test('[envelope] error is a string', function () {",
          "        var b = pm.response.json();",
          "        pm.expect(b.error).to.be.a('string');",
          "        pm.expect(b.success).to.be.undefined;",
          "    });",
          "    if (pm.response.code === 429) {",
          "        pm.test('[envelope] 429 includes retryAfter number', function () {",
          "            pm.expect(pm.response.json().retryAfter).to.be.a('number');",
          "        });",
          "    }",
          "    if (pm.response.code === 400) {",
          "        pm.test('[envelope] 400 details is object if present', function () {",
          "            var b = pm.response.json();",
          "            if (b.details !== undefined) { pm.expect(b.details).to.be.an('object'); }",
          "        });",
          "    }",
          "}"
        ]
      }
    }
