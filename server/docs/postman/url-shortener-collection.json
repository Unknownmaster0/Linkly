    {
      "name": "4. Redirect (Day 4)",
      "description": "IMPORTANT: Set Postman → Settings → 'Automatically follow redirects: OFF' before running these tests, or the 302 will be hidden.",
      "item": [
        {
          "name": "✅ Redirect — Auto Short Code → 302",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 302 Found', function () { pm.response.to.have.status(302); });",
                  "pm.test('Location header is a URL', function () {",
                  "    var loc = pm.response.headers.get('Location');",
                  "    pm.expect(loc).to.be.a('string');",
                  "    pm.expect(loc).to.include('://');",
                  "});",
                  "pm.test('No long-lived cache (not 301 behavior)', function () {",
                  "    var cc = pm.response.headers.get('Cache-Control') || '';",
                  "    pm.expect(cc).to.not.include('max-age=31536000');",
                  "});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": { "followRedirects": false },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/{{short_code}}",
              "host": ["{{base_url}}"],
              "path": ["{{short_code}}"]
            }
          }
        },
        {
          "name": "✅ Redirect — Custom Alias gh-test → github.com",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 302 Found', function () { pm.response.to.have.status(302); });",
                  "pm.test('Location points to github.com', function () {",
                  "    var loc = pm.response.headers.get('Location');",
                  "    pm.expect(loc).to.include('github.com');",
                  "});"
                ]
              }
            }
