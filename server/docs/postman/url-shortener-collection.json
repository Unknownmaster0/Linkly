    {
      "name": "3. Shorten",
      "item": [
        {
          "name": "✅ Shorten — Basic",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var token = pm.collectionVariables.get('access_token');",
                  "if (!token) { console.warn('access_token is empty — run Login first'); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response shape: success, message, data', function () {",
                  "    var b = pm.response.json();",
                  "    pm.expect(b.success).to.be.true;",
                  "    pm.expect(b.message).to.be.a('string');",
                  "    pm.expect(b.data).to.be.an('object');",
                  "    pm.expect(b.data.shortCode).to.be.a('string');",
                  "    pm.expect(b.data.shortUrl).to.include(b.data.shortCode);",
                  "    pm.expect(b.data.originalUrl).to.be.a('string');",
                  "    pm.collectionVariables.set('short_code', b.data.shortCode);",
                  "});",
                  "pm.test('Rate limit headers present', function () {",
                  "    pm.expect(pm.response.headers.get('X-RateLimit-Limit')).to.exist;",
                  "    pm.expect(pm.response.headers.get('X-RateLimit-Remaining')).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://www.google.com/search?q=postman+api+testing+guide\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/urls",
              "host": ["{{base_url}}"],
              "path": ["api", "urls"]
            }
