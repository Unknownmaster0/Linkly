NODE_ENV=production
PORT=3000
API_HOST=127.0.0.1

# Postgres/Valkey run as Docker containers on this same host, bound to
# 127.0.0.1 only (see docker-compose.yml) — the connection never leaves the
# box, so TLS isn't needed here. If the DB/cache ever move to a separate host
# or a managed service (RDS, etc.), switch HOST and add back sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
VALKEY_URL=redis://:PASSWORD@localhost:6379

JWT_SECRET=<generate-a-long-random-secret>
JWT_REFRESH_SECRET=<generate-a-different-long-random-secret>

BASE_URL=https://api.example.com
REDIRECT_URL=https://go.example.com
CLIENT_ORIGINS=https://app.example.com

DEFAULT_URL_TTL_DAYS=7
RATE_LIMIT_CREATE_LIMIT=100
RATE_LIMIT_WINDOW_SECS=3600
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW_SECS=60
RATE_LIMIT_LOGIN_ACCOUNT_LIMIT=10
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECS=900
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_REGISTER_WINDOW_SECS=60
SHUTDOWN_TIMEOUT_MS=30000
