NODE_ENV=production
PORT=3000
API_HOST=127.0.0.1

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
VALKEY_URL=redis://USER:PASSWORD@HOST:6379

JWT_SECRET=<generate-a-long-random-secret>
JWT_REFRESH_SECRET=<generate-a-different-long-random-secret>

BASE_URL=https://api.example.com
REDIRECT_URL=https://go.example.com
CLIENT_ORIGINS=https://app.example.com

DEFAULT_URL_TTL_DAYS=7
RATE_LIMIT_CREATE_LIMIT=10
RATE_LIMIT_WINDOW_SECS=60
SHUTDOWN_TIMEOUT_MS=30000
