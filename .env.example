# Used by docker-compose.yml to provision the local Postgres + Valkey containers.
# Copy to `.env` (gitignored) and fill in real values — never commit `.env`.
POSTGRES_USER=<choose-a-user>
POSTGRES_PASSWORD=<generate-a-long-random-password>
POSTGRES_DB=urlshortener

# Valkey requires this password (see docker-compose.yml's `--requirepass`).
# Mirror it into each service's VALKEY_URL, e.g. redis://:<same-password>@localhost:6379
VALKEY_PASSWORD=<generate-a-long-random-password>
